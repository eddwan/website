{
  // Separado do tsconfig do Astro: os tipos do runtime do Workers brigam com os do navegador (DOM).
  "compilerOptions": {
    "target": "es2024",
    "lib": ["es2024"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "allowImportingTsExtensions": true, // imports com .ts: o Node roda os testes direto, sem build
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["index.ts", "access.ts", "turnstile.ts", "github.ts", "worker-configuration.d.ts"]
}
