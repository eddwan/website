---
import '@fontsource-variable/inter/wght.css';
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import Icone from '../components/Icone.astro';
import { SITE, LINKS, NAV } from '../consts';
import { SERIES } from '../data/canal';

interface Props {
  titulo?: string;
  descricao?: string;
  imagem?: string; // caminho da imagem Open Graph (relativo ao site)
  tipo?: 'website' | 'article';
  publicado?: Date;
  semIndice?: boolean;
}

const { titulo, descricao = SITE.descricao, imagem = '/og/site.png', tipo = 'website', publicado, semIndice = false } =
  Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${SITE.titulo}` : `${SITE.titulo} · open source, Git e segurança`;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagemUrl = new URL(imagem, Astro.site);
const atual = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang={SITE.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.titulo} href={new URL('rss.xml', Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://i.ytimg.com" />
    <meta name="theme-color" content="#05070b" />
    <meta name="generator" content={Astro.generator} />
    {semIndice && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={tipo} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE.titulo} />
    <meta property="og:title" content={titulo ?? SITE.titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    <meta property="og:image" content={imagemUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publicado && <meta property="article:published_time" content={publicado.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={titulo ?? SITE.titulo} />
    <meta name="twitter:description" content={descricao} />
    <meta name="twitter:image" content={imagemUrl} />
    <slot name="head" />
  </head>
  <body>
    <a class="pular" href="#conteudo">Pular para o conteúdo</a>

    <header class="topo" data-topo>
      <div class="container topo-in">
        <a class="marca" href="/" aria-label="eddwan, início">
          <span class="marca-sinal" aria-hidden="true">›</span>eddwan<span class="marca-cursor" aria-hidden="true"
          ></span>
        </a>

        <nav class="nav" aria-label="Principal" id="menu">
          <ul>
            {
              NAV.map((item) => (
                <li>
                  <a href={item.href} aria-current={atual.startsWith(item.href) ? 'page' : undefined}>
                    {item.rotulo}
                  </a>
                </li>
              ))
            }
          </ul>
          <a class="btn nav-cta" href={LINKS.inscrever} rel="noopener">
            <Icone nome="youtube" /> Inscreva-se
          </a>
        </nav>

        <button class="menu-btn" type="button" aria-controls="menu" aria-expanded="false" data-menu-btn>
          <Icone nome="menu" class="ic-abrir" />
          <Icone nome="fechar" class="ic-fechar" />
          <span class="sr-only">Menu</span>
        </button>
      </div>
    </header>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="rodape">
      <div class="container">
        <div class="rodape-cta">
          <div>
            <p class="eyebrow">Vem junto</p>
            <h2>Vídeo novo no canal, conversa na comunidade.</h2>
          </div>
          <div class="rodape-botoes">
            <a class="btn" href={LINKS.inscrever} rel="noopener"><Icone nome="youtube" /> Inscrever no canal</a>
            <a class="btn btn-ghost" href={LINKS.comunidade} rel="noopener"
              ><Icone nome="whatsapp" /> Comunidade no WhatsApp</a
            >
          </div>
        </div>

        <div class="rodape-grade">
          <div class="rodape-sobre">
            <a class="marca" href="/"><span class="marca-sinal" aria-hidden="true">›</span>eddwan</a>
            <p>Open source, Git e segurança explicados em português.</p>
            <a class="rodape-ht" href={LINKS.hallentech} rel="noopener">
              Fundador da <strong>Hallen Tech</strong>
              <Icone nome="externo" />
            </a>
          </div>
          <div>
            <p class="rodape-tit">Site</p>
            <ul>
              <li><a href="/">Início</a></li>
              {
                NAV.map((item) => (
                  <li>
                    <a href={item.href}>{item.rotulo}</a>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <p class="rodape-tit">Séries</p>
            <ul>
              {
                Object.values(SERIES)
                  .filter((s) => s.playlist)
                  .map((s) => (
                    <li>
                      <a href={s.playlist} rel="noopener">
                        {s.nome}
                      </a>
                    </li>
                  ))
              }
              <li><a href="/blog/tag/noticia">Notícias</a></li>
            </ul>
          </div>
          <div>
            <p class="rodape-tit">Siga</p>
            <ul class="rodape-redes">
              <li><a href={LINKS.youtube} rel="noopener"><Icone nome="youtube" /> YouTube</a></li>
              <li><a href={LINKS.github} rel="noopener"><Icone nome="github" /> GitHub</a></li>
              <li><a href={LINKS.comunidade} rel="noopener"><Icone nome="whatsapp" /> WhatsApp</a></li>
              <li><a href="/rss.xml"><Icone nome="rss" /> RSS</a></li>
            </ul>
          </div>
        </div>

        <p class="rodape-marca" aria-hidden="true">eddwan</p>
      </div>
    </footer>

    <script>
      const topo = document.querySelector<HTMLElement>('[data-topo]');
      const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
      btn?.addEventListener('click', () => {
        const aberto = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', String(!aberto));
        topo?.classList.toggle('aberto', !aberto);
        document.body.style.overflow = aberto ? '' : 'hidden';
      });
      const rolou = () => topo?.classList.toggle('rolou', window.scrollY > 8);
      rolou();
      window.addEventListener('scroll', rolou, { passive: true });
    </script>
  </body>
</html>

<style>
  /* ── Cabeçalho ── */
  .topo {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition: background 0.3s, border-color 0.3s;
  }
  .topo.rolou,
  .topo.aberto {
    background: rgba(5, 7, 11, 0.78);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom-color: var(--line);
  }
  /* Com o menu aberto, sem backdrop-filter: ele prenderia o painel fixo dentro do cabeçalho */
  .topo.aberto {
    background: var(--bg);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
  }
  .topo-in {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 4.25rem;
  }
  .marca {
    display: inline-flex;
    align-items: center;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: 1.45rem;
    letter-spacing: -0.04em;
    color: var(--text);
    text-decoration: none;
  }
  .marca:hover {
    color: var(--text);
  }
  .marca-sinal {
    margin-right: 0.15em;
    background: var(--g-o);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .marca-cursor {
    width: 0.5em;
    height: 0.95em;
    margin-left: 0.12em;
    background: var(--b1);
    border-radius: 2px;
    animation: pisca 1.1s steps(1) infinite;
  }
  @keyframes pisca {
    50% {
      opacity: 0;
    }
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .nav ul {
    display: flex;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0.3rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: rgba(255, 255, 255, 0.025);
  }
  .nav ul a {
    display: block;
    padding: 0.4rem 0.95rem;
    border-radius: 999px;
    color: var(--text-2);
    text-decoration: none;
    font-size: 0.93rem;
    font-weight: 550;
    transition: color 0.2s, background 0.2s;
  }
  .nav ul a:hover {
    color: var(--text);
    background: rgba(255, 255, 255, 0.06);
  }
  .nav ul a[aria-current='page'] {
    color: #120800;
    background: var(--g-o);
  }
  .nav-cta {
    min-height: 2.5rem;
    padding: 0.45rem 1rem;
    font-size: 0.9rem;
  }
  .menu-btn {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: 12px;
    border: 1px solid var(--line-2);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text);
    cursor: pointer;
  }
  .menu-btn :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }
  .menu-btn :global(.ic-fechar),
  .aberto .menu-btn :global(.ic-abrir) {
    display: none;
  }
  .aberto .menu-btn :global(.ic-fechar) {
    display: block;
  }

  @media (max-width: 820px) {
    .menu-btn {
      display: grid;
    }
    .nav {
      position: fixed;
      inset: 4.25rem 0 0 0;
      flex-direction: column;
      align-items: stretch;
      gap: 1.5rem;
      padding: 1.5rem var(--gutter) 2rem;
      background: var(--bg);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-8px);
      transition: opacity 0.25s, transform 0.25s var(--ease), visibility 0.25s;
    }
    .aberto .nav {
      opacity: 1;
      visibility: visible;
      transform: none;
    }
    .nav ul {
      flex-direction: column;
      border: 0;
      background: none;
      padding: 0;
      gap: 0;
    }
    .nav ul a {
      font-family: var(--f-display);
      font-size: 2.2rem;
      font-weight: 750;
      letter-spacing: -0.03em;
      padding: 0.6rem 0;
      border-radius: 0;
      border-bottom: 1px solid var(--line);
      color: var(--text);
    }
    .nav ul a:hover {
      background: none;
    }
    .nav ul a[aria-current='page'] {
      background: none;
      color: var(--o1);
    }
    .nav-cta {
      min-height: 3.25rem;
      font-size: 1rem;
    }
  }

  main {
    min-height: 70vh;
  }

  /* ── Rodapé ── */
  .rodape {
    position: relative;
    margin-top: clamp(4rem, 10vw, 7rem);
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, var(--bg-2), var(--bg));
    overflow: hidden;
  }
  .rodape-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    padding-block: clamp(2.5rem, 6vw, 4rem);
    border-bottom: 1px solid var(--line);
  }
  .rodape-cta h2 {
    margin-top: 0.6rem;
    font-size: clamp(1.7rem, 4vw, 2.6rem);
    max-width: 30rem;
  }
  .rodape-botoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .rodape-grade {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding-block: 3rem 1rem;
    font-size: 0.95rem;
  }
  @media (min-width: 860px) {
    .rodape-grade {
      grid-template-columns: 2fr 1fr 1.3fr 1fr;
    }
  }
  .rodape-sobre {
    grid-column: 1 / -1;
  }
  @media (min-width: 860px) {
    .rodape-sobre {
      grid-column: auto;
    }
  }
  .rodape-sobre p {
    color: var(--text-2);
    max-width: 22rem;
    margin: 0.5rem 0 1rem;
  }
  .rodape-ht {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.9rem;
    border-radius: 999px;
    border: 1px solid rgba(254, 118, 2, 0.4);
    background: rgba(254, 118, 2, 0.08);
    color: var(--text);
    text-decoration: none;
    font-size: 0.9rem;
  }
  .rodape-ht strong {
    color: var(--o1);
  }
  .rodape-ht :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
    color: var(--muted);
  }
  .rodape-ht:hover {
    color: var(--text);
    border-color: var(--o2);
  }
  .rodape-tit {
    font-family: var(--f-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 0.75rem;
  }
  .rodape ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }
  .rodape-grade a:not(.marca, .rodape-ht) {
    color: var(--text-2);
    text-decoration: none;
  }
  .rodape-grade a:not(.marca, .rodape-ht):hover {
    color: var(--o1);
  }
  .rodape-redes a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .rodape-redes :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  .rodape-marca {
    margin: 1rem 0 -0.2em;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(5rem, 22vw, 17rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
    text-align: center;
    color: transparent;
    -webkit-text-stroke: 1px rgba(255, 255, 255, 0.09);
    background: linear-gradient(180deg, rgba(254, 118, 2, 0.16), transparent 75%);
    -webkit-background-clip: text;
    background-clip: text;
    user-select: none;
  }
</style>
