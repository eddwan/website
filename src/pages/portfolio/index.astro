---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

const projetos = (await getCollection('portfolio')).sort((a, b) => a.data.ordem - b.data.ordem);
const itens = await Promise.all(projetos.map(async (p) => ({ p, Content: (await render(p)).Content })));
const algumRevisar = projetos.some((p) => p.data.revisar);
---

<Base titulo="Portfólio" descricao="Projetos do Eddwan: o Estúdio, o canal no YouTube e trabalhos da Hallen Tech.">
  <div class="container">
    <header class="cab">
      <h1>Portfólio</h1>
      <p>Projetos em que trabalho ou trabalhei.</p>
      {
        algumRevisar && (
          <p class="aviso-rascunho">
            <strong>Rascunho para o Eddwan revisar.</strong> Os textos marcados abaixo foram escritos a partir do material
            do canal e ainda não foram conferidos.
          </p>
        )
      }
    </header>

    <div class="lista">
      {
        itens.map(({ p, Content }) => (
          <article class="proj" id={p.id}>
            <div class="proj-cab">
              <h2>{p.data.titulo}</h2>
              {p.data.revisar && <span class="selo">revisar</span>}
            </div>
            <p class="proj-resumo">{p.data.resumo}</p>
            {(p.data.papel || p.data.periodo) && (
              <p class="proj-meta">{[p.data.papel, p.data.periodo].filter(Boolean).join(' · ')}</p>
            )}
            <div class="prosa">
              <Content />
            </div>
            {p.data.tecnologias.length > 0 && (
              <p class="proj-tec">
                {p.data.tecnologias.map((t) => (
                  <span class="selo">{t}</span>
                ))}
              </p>
            )}
            {p.data.links.length > 0 && (
              <p class="proj-links">
                {p.data.links.map((l) => (
                  <a href={l.url} rel="noopener">
                    {l.rotulo} →
                  </a>
                ))}
              </p>
            )}
          </article>
        ))
      }
    </div>
  </div>
</Base>

<style>
  .cab {
    padding-block: 2.5rem 1rem;
  }
  .cab h1 {
    margin: 0 0 0.25rem;
    font-size: 2.4rem;
  }
  .cab > p {
    color: var(--texto-2);
  }
  .lista {
    display: grid;
    gap: 1.25rem;
  }
  .proj {
    background: var(--card);
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    padding: 1.25rem 1.4rem;
    position: relative;
    overflow: hidden;
  }
  .proj::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: var(--grad-laranja);
  }
  .proj-cab {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .proj h2 {
    margin: 0;
    font-size: 1.4rem;
  }
  .proj-resumo {
    font-size: 1.05rem;
    color: #cfd5df;
    margin: 0.5rem 0;
  }
  .proj-meta {
    color: var(--texto-2);
    font-size: 0.9rem;
    margin: 0;
  }
  .proj-tec {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .proj-tec .selo {
    text-transform: none;
    letter-spacing: 0;
  }
  .proj-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 0;
    font-weight: 600;
  }
</style>
