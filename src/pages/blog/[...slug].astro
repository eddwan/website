---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import YouTube from '../../components/YouTube.astro';
import PostCard from '../../components/PostCard.astro';
import Icone from '../../components/Icone.astro';
import { getPosts, formataData, slugTag, tempoLeitura } from '../../lib/posts';
import { TIPOS, LINKS } from '../../consts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, outros: posts.filter((p) => p.id !== post.id).slice(0, 2) },
  }));
}

const { post, outros } = Astro.props;
const { titulo, descricao, data, atualizado, tipo, tags, youtube, fontes, rascunho } = post.data;
const { Content, headings } = await render(post);
const sumario = headings.filter((h) => h.depth === 2);
const corTipo = tipo === 'noticia' ? 'tag-o' : tipo === 'explicativo' ? 'tag-b' : '';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': tipo === 'noticia' ? 'NewsArticle' : 'BlogPosting',
  headline: titulo,
  description: descricao,
  datePublished: data.toISOString(),
  dateModified: (atualizado ?? data).toISOString(),
  author: { '@type': 'Person', name: 'Eddwan', url: Astro.site?.toString() },
  image: new URL(`/og/${post.id}.png`, Astro.site).toString(),
  inLanguage: 'pt-BR',
};
---

<Base titulo={titulo} descricao={descricao} imagem={`/og/${post.id}.png`} tipo="article" publicado={data} semIndice={rascunho}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <article>
    <header class="cab">
      <div class="grid-bg"></div>
      <div class="container cab-in">
        <nav class="trilha" aria-label="Você está em">
          <a href="/blog">Blog</a>
          <span aria-hidden="true">/</span>
          <span class:list={['tag', corTipo]}>{TIPOS[tipo]}</span>
        </nav>
        <h1>{titulo}</h1>
        <p class="desc">{descricao}</p>
        <p class="meta">
          <span class="autor">
            <img src="/img/eddwan.jpg" alt="" width="40" height="40" />
            <span><strong>Eddwan</strong><br /><time datetime={data.toISOString()}>{formataData(data)}</time></span>
          </span>
          <span class="leitura"><Icone nome="relogio" /> {tempoLeitura(post.body)} min de leitura</span>
        </p>
        {rascunho && <p class="aviso-rascunho"><strong>Rascunho.</strong> Este post não entra no build de produção.</p>}
      </div>
    </header>

    {
      youtube && (
        <div class:list={['container video', youtube.formato === 'short' && 'video-short']}>
          <YouTube id={youtube.id} titulo={titulo} formato={youtube.formato} />
        </div>
      )
    }

    <div class="container corpo">
      <div class="prosa">
        <Content />

        {
          youtube && youtube.shorts.length > 0 && (
            <section class="bloco">
              <h2>Shorts deste vídeo</h2>
              <ul class="lista-links">
                {youtube.shorts.map((s) => (
                  <li>
                    <a href={`https://www.youtube.com/shorts/${s.id}`} rel="noopener">
                      <Icone nome="youtube" /> {s.titulo}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        {
          fontes.length > 0 && (
            <section class="bloco">
              <h2>Fontes</h2>
              <ol class="fontes">
                {fontes.map((f) => (
                  <li>
                    <a href={f.url} rel="noopener">
                      {f.titulo}
                    </a>
                    <span>{new URL(f.url).hostname.replace('www.', '')}</span>
                  </li>
                ))}
              </ol>
            </section>
          )
        }

        {
          tags.length > 0 && (
            <p class="post-tags">
              {tags.map((t) => (
                <a class="tag" href={`/blog/tag/${slugTag(t)}`}>
                  #{t}
                </a>
              ))}
            </p>
          )
        }
      </div>

      <aside class="lateral">
        {
          sumario.length > 1 && (
            <nav class="sumario" aria-label="Neste post">
              <p class="lateral-tit">Neste post</p>
              <ol>
                {sumario.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ol>
            </nav>
          )
        }
        <div class="cta">
          <p class="lateral-tit">Canal @eddwan</p>
          <p>Open source, Git e segurança em vídeo, em português.</p>
          <a class="btn" href={LINKS.inscrever} rel="noopener"><Icone nome="youtube" /> Inscrever</a>
          <a class="btn btn-ghost" href={LINKS.comunidade} rel="noopener"><Icone nome="whatsapp" /> Comunidade</a>
        </div>
      </aside>
    </div>
  </article>

  {
    outros.length > 0 && (
      <section class="container mais">
        <div class="secao-cab">
          <div>
            <p class="eyebrow">Continue lendo</p>
            <h2>Mais do blog</h2>
          </div>
          <a class="link-seta" href="/blog">
            Todos os posts
          </a>
        </div>
        <div class="mais-grade">
          {outros.map((p) => (
            <PostCard post={p} />
          ))}
        </div>
      </section>
    )
  }
</Base>

<style>
  .cab {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(2rem, 4vw, 2.5rem);
  }
  .cab-in {
    max-width: 62rem;
  }
  .trilha {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--f-mono);
    font-size: 0.8rem;
    color: var(--muted);
  }
  .trilha a {
    color: var(--text-2);
    text-decoration: none;
  }
  .trilha a:hover {
    color: var(--o1);
  }
  h1 {
    margin-top: 1.25rem;
    font-size: clamp(2.3rem, 6.5vw, 4.4rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.045em;
  }
  .desc {
    margin: 1.25rem 0 0;
    max-width: 44rem;
    font-size: clamp(1.08rem, 2vw, 1.3rem);
    line-height: 1.55;
    color: var(--text-2);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 2rem;
    margin: 2rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
  }
  .autor {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    line-height: 1.35;
  }
  .autor strong {
    color: var(--text);
  }
  .autor img {
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--o2);
  }
  .leitura {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--f-mono);
    font-size: 0.8rem;
  }
  .leitura :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  .video {
    max-width: 66rem;
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }
  .video-short {
    display: flex;
    justify-content: center;
  }
  .video-short > :global(*) {
    width: 100%;
  }

  .corpo {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    max-width: 66rem;
  }
  @media (min-width: 1000px) {
    .corpo {
      grid-template-columns: minmax(0, 1fr) 16rem;
      gap: 4rem;
    }
  }
  .lateral {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    align-self: start;
  }
  @media (min-width: 1000px) {
    .lateral {
      position: sticky;
      top: 6rem;
    }
  }
  .lateral-tit {
    margin: 0 0 0.75rem;
    font-family: var(--f-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .sumario ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 1px solid var(--line-2);
    counter-reset: s;
  }
  .sumario li {
    counter-increment: s;
  }
  .sumario a {
    display: flex;
    gap: 0.6rem;
    padding: 0.35rem 0 0.35rem 1rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--text-2);
    text-decoration: none;
  }
  .sumario a:hover {
    color: var(--text);
    border-left-color: var(--o2);
  }
  .cta {
    padding: 1.25rem;
    border-radius: var(--r);
    border: 1px solid var(--line-2);
    background:
      radial-gradient(14rem 10rem at 100% 0%, rgba(254, 118, 2, 0.16), transparent 70%), var(--surface);
  }
  .cta p:not(.lateral-tit) {
    margin: 0 0 1rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--text-2);
  }
  .cta .btn {
    width: 100%;
    min-height: 2.6rem;
    font-size: 0.9rem;
  }
  .cta .btn + .btn {
    margin-top: 0.5rem;
  }

  .bloco h2 {
    font-size: 1.5rem;
  }
  .lista-links {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }
  .lista-links li + li {
    margin-top: 0;
  }
  .lista-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }
  .lista-links :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
    color: #ff3d3d;
  }
  .fontes {
    padding-left: 1.4rem;
  }
  .fontes span {
    display: block;
    font-family: var(--f-mono);
    font-size: 0.75rem;
    color: var(--muted);
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .post-tags a {
    text-transform: none;
    letter-spacing: 0;
    text-decoration: none;
  }
  .mais {
    margin-top: clamp(4rem, 9vw, 6rem);
  }
  .mais .secao-cab h2 {
    font-size: clamp(1.8rem, 4vw, 2.6rem);
  }
  .mais-grade {
    display: grid;
    gap: 1.25rem;
  }
  @media (min-width: 760px) {
    .mais-grade {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
