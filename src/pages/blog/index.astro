---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import CabecalhoPagina from '../../components/CabecalhoPagina.astro';
import { getPosts, todasAsTags } from '../../lib/posts';

const posts = await getPosts();
const tags = todasAsTags(posts);
const [primeiro, ...resto] = posts;
---

<Base titulo="Blog" descricao="Artigos, notícias e listas sobre open source, Git, segurança e tecnologia.">
  <CabecalhoPagina
    eyebrow={`${posts.length} posts`}
    titulo="Blog"
    lead="Artigos, notícias e listas. Cada vídeo do canal também vira um post, com o passo a passo, os links e as fontes."
  >
    <nav class="tags" aria-label="Tags">
      {tags.map((t) => <a class="tag" href={`/blog/tag/${t.slug}`}>#{t.tag} <span>{t.total}</span></a>)}
    </nav>
  </CabecalhoPagina>

  <div class="container">
    {primeiro && <PostCard post={primeiro} grande />}
    <div class="grade">
      {resto.map((post) => <PostCard post={post} />)}
    </div>
  </div>
</Base>

<style>
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 2rem;
  }
  .tags a {
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.8rem;
  }
  .tags span {
    opacity: 0.5;
  }
  .grade {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
  }
</style>
