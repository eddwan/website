---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import YouTube from '../components/YouTube.astro';
import Icone from '../components/Icone.astro';
import { getPosts, formataDataCurta } from '../lib/posts';
import { LINKS } from '../consts';
import { avisoLives } from '../data/lives'; // LIVES-VOTACAO (temporário)
import { VIDEOS, SERIES, NUMEROS, REPOS_NO_CANAL, thumb } from '../data/canal';

const posts = await getPosts();
const postPorVideo = new Map(posts.filter((p) => p.data.youtube).map((p) => [p.data.youtube!.id, p.id]));
const destaque = posts.find((p) => p.data.youtube?.formato === 'video');
const principal = posts[0];
// No bloco do blog, evita repetir em destaque o post do vídeo que já aparece acima
const doBlog = posts.filter((p) => p.id !== destaque?.id);
const blogDestaque = doBlog[0] ?? principal;
const blogOutros = [...doBlog.slice(1), ...(destaque ? [destaque] : [])].slice(0, 2);
const recentes = VIDEOS.filter((v) => v.id !== destaque?.data.youtube?.id).slice(0, 4);
const deSerie = (s: string) => VIDEOS.filter((v) => v.serie === s);
const noticias = posts.filter((p) => p.data.tipo === 'noticia');
// Na home, só três projetos: um produto com download, o produto que está no ar e o canal
const DESTAQUES_PORTFOLIO = ['estudio', 'vivahq', 'canal-eddwan'];
const todosProjetos = await getCollection('portfolio');
// LIVES-VOTACAO: aviso temporário no topo do hero (some sozinho depois de 02/12/2026)
const lives = avisoLives();
const projetos = DESTAQUES_PORTFOLIO.map((id) => todosProjetos.find((p) => p.id === id)).filter((p) => p !== undefined);
const terminal = posts.slice(0, 3).map((p) => ({
  hash: (p.data.youtube?.id ?? p.id).replace(/[^a-zA-Z0-9]/g, '').slice(0, 7).toLowerCase(),
  titulo: p.data.titulo.split(':')[0],
}));
---

<Base>
  <!-- ═════════ HERO ═════════ -->
  <section class="hero">
    <div class="grid-bg"></div>
    <div class="container hero-grade">
      <div class="hero-texto">
        {/* LIVES-VOTACAO: enquanto houver lives, a pílula do topo anuncia as lives no lugar do post novo */}
        {lives ? (
          <a class="hero-status hero-status-live" href={lives.link} rel="noopener">
            <span class="pulso pulso-live" aria-hidden="true" />
            <span class="hero-status-rot">{lives.rotulo}</span>
            <span class="hero-status-tit">{lives.texto}</span>
            <Icone nome="seta" />
          </a>
        ) : (
          principal && (
            <a class="hero-status" href={`/blog/${principal.id}`}>
              <span class="pulso" aria-hidden="true" />
              <span class="hero-status-rot">Novo</span>
              <span class="hero-status-tit">{principal.data.titulo.split(':')[0]}</span>
              <Icone nome="seta" />
            </a>
          )
        )}
        <h1>
          Open source, Git e segurança, <span class="t-grad-ob">sem enrolação.</span>
        </h1>
        <!-- RASCUNHO: frase de apresentação para o Eddwan revisar -->
        <p class="hero-lead">
          Eu sou o <strong>Eddwan</strong>, fundador da Hallen Tech. No canal <strong>@eddwan</strong> eu garimpo projetos
          open source do GitHub, ensino Git do zero e comento as notícias de tecnologia e segurança que importam.
        </p>
        <div class="hero-acoes">
          <a class="btn" href={LINKS.inscrever} rel="noopener"><Icone nome="youtube" /> Inscreva-se no canal</a>
          <a class="btn btn-ghost" href={LINKS.youtube} rel="noopener">Assistir no YouTube <Icone nome="seta" /></a>
        </div>
        <dl class="numeros">
          {
            NUMEROS.map((n) => (
              <div>
                <dt>{n.rotulo}</dt>
                <dd>{n.valor}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="foto">
          <img src="/img/eddwan-retrato.jpg" alt="" width="800" height="1000" fetchpriority="high" />
          <div class="foto-nome">
            <span>Eddwan</span>
            <span class="foto-arroba">@eddwan</span>
          </div>
        </div>
        <div class="terminal">
          <div class="terminal-topo">
            <i></i><i></i><i></i>
            <span>~/canal</span>
          </div>
          <pre><span class="c-prompt">$</span> git log --oneline -3
{terminal.map((t) => <><span class="c-hash">{t.hash}</span> {t.titulo}{'\n'}</>)}<span class="c-prompt">$</span> <span class="c-cursor"></span></pre>
        </div>
        <div class="chip chip-1"><Icone nome="youtube" /> Vol. 24 no ar</div>
        <div class="chip chip-2"><span class="t-grad-b">git</span> do zero · 10 eps</div>
      </div>
    </div>
  </section>

  <!-- ═════════ FAIXA DE REPOSITÓRIOS ═════════ -->
  <section class="faixa" aria-label="Projetos que já passaram pelo canal">
    <p class="faixa-rot">No último volume</p>
    <div class="faixa-trilho">
      <ul>
        {REPOS_NO_CANAL.map((r) => <li>{r}</li>)}
      </ul>
      <ul aria-hidden="true">
        {REPOS_NO_CANAL.map((r) => <li>{r}</li>)}
      </ul>
    </div>
  </section>

  <!-- ═════════ INSCRIÇÃO NO CANAL ═════════ -->
  <section class="container secao-inscrever">
    <div class="inscrever revela">
      <div class="inscrever-texto">
        <p class="eyebrow">Canal no YouTube</p>
        <h2>Inscreva-se no canal <span class="t-grad">@eddwan</span>.</h2>
        <p>
          Vídeo novo quase todo dia: listas de projetos open source do GitHub, Git e inteligência artificial do zero e
          as notícias de segurança que importam. Ative o sininho para não perder nenhum.
        </p>
        {
          /* LIVES-VOTACAO: linha temporária sobre as lives (some sozinha depois de 02/12/2026) */
          lives && (
            <p class="inscrever-lives">
              <span class="pulso pulso-live" aria-hidden="true" />
              <span>
                De <strong>17/11 a 02/12</strong>, lives de <strong>terça a sexta, das 20h às 21h30</strong>,
                construindo ao vivo a votação open source do eddwan.com com inteligência artificial (Claude Code).
              </span>
            </p>
          )
        }
      </div>
      <div class="inscrever-acoes">
        <a class="btn btn-grande" href={LINKS.inscrever} rel="noopener">
          <Icone nome="youtube" /> Inscreva-se no canal
        </a>
        {
          lives && (
            <a class="btn btn-ghost" href={lives.link} rel="noopener">
              Ver as lives <Icone nome="seta" />
            </a>
          )
        }
        <span class="inscrever-url">youtube.com/@eddwan</span>
      </div>
    </div>
  </section>

  <!-- ═════════ SÉRIES ═════════ -->
  <section class="secao container">
    <div class="secao-cab revela">
      <div>
        <p class="eyebrow">As séries</p>
        <h2>Escolha por onde começar.</h2>
        <p>Listas para descobrir ferramentas novas, um curso de Git do jeito certo e notícias com fonte conferida.</p>
      </div>
    </div>

    <div class="bento">
      <a class="card serie serie-os revela" href={SERIES['open-source'].playlist} rel="noopener">
        <div class="mosaico">
          {deSerie('open-source').slice(0, 9).map((v) => <img src={thumb(v.id, 'mq')} alt="" decoding="async" width="320" height="180" />)}
        </div>
        <div class="serie-corpo">
          <span class="serie-num t-grad">24</span>
          <div>
            <p class="eyebrow">Playlist · volumes</p>
            <h3>{SERIES['open-source'].nome}</h3>
            <p>{SERIES['open-source'].resumo}</p>
            <span class="link-seta">Ver a playlist</span>
          </div>
        </div>
      </a>

      <a class="card serie serie-git revela" href={SERIES.git.playlist} rel="noopener">
        <div class="mosaico mosaico-4">
          {deSerie('git').slice(0, 4).map((v) => <img src={thumb(v.id, 'mq')} alt="" decoding="async" width="320" height="180" />)}
        </div>
        <div class="serie-corpo">
          <span class="serie-num t-grad-b">10</span>
          <div>
            <p class="eyebrow azul">Playlist · episódios</p>
            <h3>{SERIES.git.nome}</h3>
            <p>{SERIES.git.resumo}</p>
            <span class="link-seta">Começar pelo ep. 1</span>
          </div>
        </div>
      </a>

      <a class="card serie serie-news revela" href="/blog/tag/noticia">
        <div class="news-alerta">
          <span class="tag tag-o tag-ponto">Urgente</span>
          {noticias[0] && <p>{noticias[0].data.titulo}</p>}
        </div>
        <div class="serie-corpo">
          <div>
            <p class="eyebrow">Shorts · notícias</p>
            <h3>Notícias e segurança</h3>
            <p>Falhas críticas, atualizações e mudanças que afetam o seu site ou o seu código, com as fontes no post.</p>
            <span class="link-seta">Ver as notícias</span>
          </div>
        </div>
      </a>
    </div>
  </section>

  <!-- ═════════ ÚLTIMO VÍDEO ═════════ -->
  {
    destaque && (
      <section class="secao secao-video">
        <div class="container">
          <div class="secao-cab revela">
            <div>
              <p class="eyebrow">Último vídeo</p>
              <h2>{destaque.data.titulo.split(':')[0]}</h2>
            </div>
            <a class="link-seta" href="/videos">
              Todos os vídeos
            </a>
          </div>
          <div class="video-grade">
            <div class="revela">
              <YouTube id={destaque.data.youtube!.id} titulo={destaque.data.titulo} />
              <div class="video-info">
                <p>{destaque.data.descricao}</p>
                <a class="btn btn-ghost" href={`/blog/${destaque.id}`}>
                  Resumo, links e fontes <Icone nome="seta" />
                </a>
              </div>
            </div>
            <aside class="recentes revela" aria-label="Vídeos recentes">
              <p class="recentes-tit">Mais recentes</p>
              <ul>
                {recentes.map((v) => {
                  const post = postPorVideo.get(v.id);
                  return (
                    <li>
                      <a
                        href={post ? `/blog/${post}` : `https://www.youtube.com/watch?v=${v.id}`}
                        rel={post ? undefined : 'noopener'}
                      >
                        <img src={thumb(v.id, 'mq')} alt="" loading="lazy" width="320" height="180" />
                        <span>
                          <span class="recentes-rot">
                            {v.rotulo}
                            {v.data && ` · ${formataDataCurta(new Date(v.data + 'T12:00:00Z'))}`}
                          </span>
                          <span class="recentes-titulo">{v.titulo}</span>
                        </span>
                      </a>
                    </li>
                  );
                })}
              </ul>
              <a class="btn btn-ghost recentes-btn" href={LINKS.inscrever} rel="noopener">
                <Icone nome="youtube" /> Inscrever no canal
              </a>
            </aside>
          </div>
        </div>
      </section>
    )
  }

  <!-- ═════════ BLOG ═════════ -->
  <section class="secao container">
    <div class="secao-cab revela">
      <div>
        <p class="eyebrow">Do blog</p>
        <h2>Para ler com calma.</h2>
        <p>Cada vídeo vira um post com o passo a passo, os comandos, os links e as fontes.</p>
      </div>
      <a class="link-seta" href="/blog">Todos os posts</a>
    </div>
    {blogDestaque && <div class="revela"><PostCard post={blogDestaque} grande /></div>}
    <div class="grade-2">
      {blogOutros.map((post) => <div class="revela"><PostCard post={post} /></div>)}
    </div>
  </section>

  <!-- ═════════ PORTFÓLIO ═════════ -->
  <section class="secao container">
    <div class="secao-cab revela">
      <div>
        <p class="eyebrow azul">Portfólio</p>
        <h2>O que eu construo.</h2>
      </div>
      <a class="link-seta" href="/portfolio">Ver o portfólio</a>
    </div>
    <ol class="projetos">
      {
        projetos.map((p, i) => (
          <li class="revela">
            <a class="card projeto" href={`/portfolio#${p.id}`}>
              <span class="projeto-num">{String(i + 1).padStart(2, '0')}</span>
              <h3>{p.data.titulo}</h3>
              <p>{p.data.resumo}</p>
              <span class="projeto-seta" aria-hidden="true">
                <Icone nome="seta" />
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- ═════════ HALLEN TECH ═════════ -->
  <section class="container">
    <div class="ht revela">
      <div class="ht-texto">
        <p class="eyebrow">Para empresas</p>
        <h2>Tecnologia na sua empresa, com quem entende.</h2>
        <p>
          A Hallen Tech oferece liderança de tecnologia sob demanda, software, cloud e segurança para a sua empresa.
        </p>
      </div>
      <a class="btn btn-azul" href={LINKS.hallentech} rel="noopener">Conhecer a Hallen Tech <Icone nome="externo" /></a>
    </div>
  </section>
</Base>

<style>
  /* ── Hero ── */
  .hero {
    position: relative;
    padding-block: clamp(2.5rem, 7vw, 5.5rem) clamp(3rem, 7vw, 5rem);
    overflow: hidden;
  }
  .hero-grade {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3.5rem;
    align-items: center;
  }
  @media (min-width: 980px) {
    .hero-grade {
      grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
      gap: 4rem;
    }
  }
  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    max-width: 100%;
    padding: 0.35rem 0.85rem 0.35rem 0.4rem;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: rgba(255, 255, 255, 0.04);
    color: var(--text-2);
    text-decoration: none;
    font-size: 0.88rem;
    margin-bottom: 1.75rem;
  }
  .hero-status:hover {
    color: var(--text);
    border-color: rgba(254, 118, 2, 0.5);
  }
  .hero-status :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
    flex: none;
  }
  .hero-status-rot {
    font-family: var(--f-mono);
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.15rem 0.5rem;
    border-radius: 999px;
    color: #120800;
    background: var(--g-o);
  }
  .hero-status-tit {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pulso {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    margin-left: 0.35rem;
    border-radius: 50%;
    background: #3ddc84;
    flex: none;
  }
  .pulso::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #3ddc84;
    animation: pulso 2s ease-out infinite;
  }
  @keyframes pulso {
    to {
      transform: scale(3);
      opacity: 0;
    }
  }
  h1 {
    font-size: clamp(2.6rem, 8.2vw, 5.2rem);
    font-weight: 800;
    line-height: 0.95;
    letter-spacing: -0.05em;
  }
  .hero-lead {
    margin: 1.75rem 0 0;
    max-width: 36rem;
    font-size: clamp(1.08rem, 2vw, 1.25rem);
    line-height: 1.6;
    color: var(--text-2);
  }
  .hero-lead strong {
    color: var(--text);
    font-weight: 600;
  }
  .hero-acoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
  .numeros {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 2.75rem 0 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    max-width: 34rem;
  }
  .numeros div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.2rem;
  }
  .numeros dd {
    margin: 0;
    font-family: var(--f-display);
    font-weight: 800;
    font-size: clamp(1.9rem, 5vw, 2.6rem);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .numeros div:first-child dd {
    background: var(--g-o);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .numeros div:nth-child(2) dd {
    background: var(--g-b);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .numeros dt {
    font-size: 0.82rem;
    line-height: 1.35;
    color: var(--muted);
  }

  /* Visual do hero: foto + terminal + chips */
  .hero-visual {
    position: relative;
    max-width: 30rem;
    width: 100%;
    margin-inline: auto;
    padding: 0 0 3.5rem 0;
  }
  .foto {
    position: relative;
    margin-left: auto;
    width: 82%;
    aspect-ratio: 4 / 5;
    border-radius: 28px;
    padding: 2px;
    background: linear-gradient(150deg, var(--o1), var(--o2) 30%, rgba(255, 255, 255, 0.08) 55%, var(--b2) 80%, var(--b1));
    transform: rotate(2.5deg);
    box-shadow: 0 50px 100px -40px rgba(254, 118, 2, 0.45), 0 40px 80px -50px rgba(1, 131, 251, 0.6);
  }
  .foto img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 26px;
    filter: saturate(1.05) contrast(1.05);
  }
  .foto::after {
    content: '';
    position: absolute;
    inset: 2px;
    border-radius: 26px;
    background: linear-gradient(180deg, transparent 55%, rgba(5, 7, 11, 0.85));
  }
  .foto-nome {
    position: absolute;
    left: 1.25rem;
    right: 1.25rem;
    bottom: 1.1rem;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--f-display);
    font-weight: 750;
    font-size: 1.4rem;
    letter-spacing: -0.03em;
  }
  .foto-arroba {
    font-family: var(--f-mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--o1);
    letter-spacing: 0;
  }
  .terminal {
    position: absolute;
    left: 0;
    bottom: 0;
    width: min(88%, 22rem);
    border-radius: 14px;
    border: 1px solid var(--line-2);
    background: rgba(10, 14, 21, 0.88);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.8);
    transform: rotate(-2deg);
    overflow: hidden;
  }
  .terminal-topo {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid var(--line);
    font-family: var(--f-mono);
    font-size: 0.7rem;
    color: var(--muted);
  }
  .terminal-topo i {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: #ff5f57;
  }
  .terminal-topo i:nth-child(2) {
    background: #febc2e;
  }
  .terminal-topo i:nth-child(3) {
    background: #28c840;
    margin-right: 0.5rem;
  }
  .terminal pre {
    margin: 0;
    padding: 0.85rem 1rem 1rem;
    font-family: var(--f-mono);
    font-size: 0.74rem;
    line-height: 1.75;
    color: var(--text-2);
    white-space: pre-wrap;
  }
  .c-prompt {
    color: #3ddc84;
  }
  .c-hash {
    color: var(--o1);
  }
  .c-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    vertical-align: text-bottom;
    background: var(--b1);
    animation: pisca2 1.1s steps(1) infinite;
  }
  @keyframes pisca2 {
    50% {
      opacity: 0;
    }
  }
  .chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--line-2);
    background: rgba(15, 20, 29, 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    font-family: var(--f-mono);
    font-size: 0.75rem;
    font-weight: 600;
    white-space: nowrap;
    box-shadow: 0 16px 30px -12px rgba(0, 0, 0, 0.7);
    animation: flutua 6s ease-in-out infinite;
  }
  .chip :global(svg) {
    width: 1rem;
    height: 1rem;
    color: #ff3d3d;
  }
  .chip-1 {
    top: 8%;
    left: 0;
  }
  .chip-2 {
    top: 46%;
    right: -0.5rem;
    animation-delay: -3s;
  }
  @keyframes flutua {
    50% {
      transform: translateY(-10px);
    }
  }
  @media (max-width: 520px) {
    .chip-2 {
      right: 0;
    }
  }

  /* LIVES-VOTACAO: pílula das lives (o texto pode quebrar linha no celular) */
  .hero-status-live {
    border-color: rgba(3, 231, 252, 0.45);
    background: rgba(3, 231, 252, 0.06);
    border-radius: 18px;
  }
  .hero-status-live:hover {
    border-color: rgba(3, 231, 252, 0.8);
  }
  .hero-status-live .hero-status-rot {
    white-space: nowrap;
  }
  .hero-status-live .hero-status-tit {
    white-space: normal;
    line-height: 1.35;
  }
  .pulso-live,
  .pulso-live::after {
    background: #ff3d3d;
  }

  /* ── Inscrição no canal ── */
  .secao-inscrever {
    margin-top: clamp(3rem, 7vw, 5rem);
  }
  .inscrever {
    position: relative;
    display: flex;
    flex-wrap: wrap;
