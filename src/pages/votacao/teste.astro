---
import Base from '../../layouts/Base.astro';
import CabecalhoPagina from '../../components/CabecalhoPagina.astro';

// Página de teste do Turnstile (Live 4, issue #18): fora do menu, do sitemap (astro.config.mjs) e dos buscadores.
// O script da Cloudflare só é carregado aqui, pelo script no fim da página.
---

<Base titulo="Teste do Turnstile" descricao="Página de teste da verificação anti-robô da votação." semIndice>
  <CabecalhoPagina
    eyebrow="Votação · teste"
    titulo="Teste do Turnstile"
    lead="Confere o anti-robô da Cloudflare de ponta a ponta: o widget gera um token e o Worker valida no /api/turnstile/teste."
  />

  <section class="container teste">
    <form method="post" action="/api/turnstile/teste" data-form>
      <div class="widget" data-widget></div>
      <button class="btn" type="submit" data-enviar>Enviar</button>
    </form>
    <output class="resultado" role="status" aria-live="polite" data-resultado hidden></output>
  </section>
</Base>

<style>
  .teste {
    padding-block: 2rem 5rem;
  }
  form,
  .resultado {
    max-width: 40rem; /* largura no conteúdo, não no container: fica alinhado ao título */
  }
  form {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .widget {
    min-height: 65px; /* altura do widget, para a página não pular quando ele aparece */
  }
  .resultado {
    display: block;
    margin-top: 1.5rem;
    padding: 1rem 1.25rem;
    border-radius: var(--r-sm);
    border: 1px solid var(--line-2);
    background: var(--surface);
    font-family: var(--f-mono);
    font-size: 0.85rem;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .resultado[hidden] {
    display: none; /* o display: block acima anularia o atributo hidden */
  }
  .resultado.ok {
    border-color: #3ddc84;
  }
  .resultado.erro {
    border-color: #ff7b72;
  }
</style>

<script>
  import { turnstileSitekey } from '../../consts';

  interface Turnstile {
    render(alvo: HTMLElement, opcoes: { sitekey: string; theme?: string }): string;
    reset(id?: string): void;
  }
  const janela = window as Window & { turnstile?: Turnstile; aoCarregarTurnstile?: () => void };

  const form = document.querySelector<HTMLFormElement>('[data-form]')!;
  const widget = document.querySelector<HTMLElement>('[data-widget]')!;
  const botao = document.querySelector<HTMLButtonElement>('[data-enviar]')!;
  const resultado = document.querySelector<HTMLOutputElement>('[data-resultado]')!;
  let widgetId: string | undefined;

  function mostrar(texto: string, classe: 'ok' | 'erro') {
    resultado.textContent = texto;
    resultado.className = `resultado ${classe}`;
    resultado.hidden = false;
  }

  // Renderização explícita: escolhe a sitekey pelo endereço (chave de teste em localhost, inclusive no cf:dev)
  janela.aoCarregarTurnstile = () => {
    widgetId = janela.turnstile!.render(widget, { sitekey: turnstileSitekey(location.hostname), theme: 'dark' });
  };
  const script = document.createElement('script');
  script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit&onload=aoCarregarTurnstile';
  script.async = true;
  script.onerror = () => mostrar('Não foi possível carregar o Turnstile da Cloudflare.', 'erro');
  document.head.append(script);

  form.addEventListener('submit', async (evento) => {
    evento.preventDefault();
    botao.disabled = true;
    try {
      // O widget põe o token no campo oculto cf-turnstile-response dentro do formulário
      const resposta = await fetch(form.action, { method: 'POST', body: new FormData(form) });
      const corpo = await resposta.text();
      mostrar(`HTTP ${resposta.status}\n${corpo}`, resposta.ok ? 'ok' : 'erro');
    } catch {
      mostrar('Falha de rede ao chamar a API.', 'erro');
    } finally {
      // Cada token só vale uma vez: gera outro para o próximo envio
      if (widgetId !== undefined) janela.turnstile?.reset(widgetId);
      botao.disabled = false;
    }
  });
</script>
