---
interface Props {
  eyebrow: string;
  titulo: string;
  lead?: string;
  azul?: boolean;
}
const { eyebrow, titulo, lead, azul = false } = Astro.props;
---

<header class="cab">
  <div class="grid-bg"></div>
  <div class="container">
    <p class:list={['eyebrow', azul && 'azul']}>{eyebrow}</p>
    <h1>{titulo}<span class:list={['ponto', azul ? 't-grad-b' : 't-grad']}>.</span></h1>
    {lead && <p class="lead">{lead}</p>}
    <slot />
  </div>
</header>

<style>
  .cab {
    position: relative;
    padding-block: clamp(3rem, 8vw, 5.5rem) clamp(2rem, 4vw, 3rem);
    overflow: hidden;
  }
  h1 {
    margin-top: 0.9rem;
    font-size: clamp(3rem, 10vw, 6.5rem);
    font-weight: 800;
    line-height: 0.92;
    letter-spacing: -0.055em;
  }
  .lead {
    margin: 1.25rem 0 0;
    max-width: 38rem;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: var(--text-2);
  }
</style>
