// Cloudflare Workers com arquivos estáticos: o Astro gera dist/ e o wrangler sobe tudo. O código do
// Worker (worker/index.ts) só roda em /api/*; o resto sai direto do dist/.
// Publicar: npm run cf:deploy (faz o build antes). Prévia: npm run cf:dev. Tipos: npm run cf:types.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "eddwan-website",
	"account_id": "1b3df666d2be7ef806120078f7a032f0",
	"main": "worker/index.ts",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./dist",
		// env.ASSETS no Worker; só /api/* passa pelo Worker antes dos arquivos estáticos
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		],
		// /sobre serve dist/sobre/index.html (/sobre/ redireciona para /sobre); o resto que não existir cai no 404 do Astro
		"html_handling": "drop-trailing-slash",
		"not_found_handling": "404-page"
	},
	// O domínio já está na zona da Cloudflare: o deploy cria o registro DNS e o certificado.
	// O www fica com outro Worker, que só redireciona (cloudflare/www-redirect).
	"routes": [
		{
			"pattern": "eddwan.com",
			"custom_domain": true
		}
	],
	// Endereço eddwan-website.<conta>.workers.dev desligado: o site só responde no domínio
	"workers_dev": false,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	// Banco D1 (env.DB no Worker). Migrações em migrations/; local: npx wrangler d1 migrations apply eddwan-votos --local
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "eddwan-votos",
			"database_id": "63ea6b79-e84e-4f22-84f3-77a3405d799d",
			"migrations_dir": "migrations"
		}
	],
	// Rate Limiting dos Workers (env.LIMITE_IP): no máximo 5 pedidos a /api/entrar a cada 60 segundos por IP.
	// O contador é por local da Cloudflare e aproximado: é freio, não garantia. O IP não vai para o banco.
	// namespace_id: número escolhido por nós, único na conta.
	"ratelimits": [
		{
			"name": "LIMITE_IP",
			"namespace_id": "1001",
			"simple": {
				"limit": 5,
				"period": 60
			}
		}
	],
	// Cloudflare Access na frente de eddwan.com/admin e eddwan.com/api/admin (issue #22). O Worker confere
	// o JWT do cabeçalho Cf-Access-Jwt-Assertion (worker/access.ts). Os dois valores são públicos (não são segredo):
	// - ACCESS_AUD: o "Application Audience (AUD) Tag" do aplicativo, em Zero Trust → Access → Applications →
	//   (o aplicativo do admin) → Overview.
	// - ACCESS_EQUIPE: o nome da equipe do Zero Trust, a parte antes de .cloudflareaccess.com no "Team domain"
	//   (Zero Trust → Settings → Custom Pages). Só o nome, sem https:// nem o domínio.
	// Vazios, /api/admin/* responde 503.
	"vars": {
		"ACCESS_AUD": "",
		"ACCESS_EQUIPE": ""
	},
	// Cron Trigger: todo dia às 06:00 UTC o handler scheduled do Worker apaga códigos e sessões vencidos.
	// Teste local: npm run cf:dev -- --test-scheduled e
	// curl -X POST "http://localhost:8787/cdn-cgi/local/explorer/api/local/scheduled?worker=eddwan-website" \
	//   -H 'Content-Type: application/json' -d '{"cron":"0 6 * * *"}'
	// (o /__scheduled não serve aqui: com assets, só /api/* chega ao Worker e ele cai no 404 do Astro)
	"triggers": {
		"crons": [
			"0 6 * * *"
		]
	}
}